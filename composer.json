{
    "name": "obelaw/ium-accounting",
    "description": "Enterprise General Ledger & Financial Management (FMS) Domain Module for Obelawium ERP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "obelaw",
        "obelawium",
        "ium",
        "accounting",
        "general-ledger",
        "double-entry",
        "fms",
        "erp",
        "vat",
        "reconciliation",
        "fixed-assets",
        "laravel"
    ],
    "authors": [
        {
            "name": "Obelaw Team",
            "email": "consulting@obelaw.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "obelaw/ium": "^1.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/validation": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Obelaw\\Ium\\Accounting\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Obelaw\\Ium\\Accounting\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Obelaw\\Ium\\Accounting\\Providers\\ObelawAccountingServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
